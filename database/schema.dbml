Project learnova {
  database_type: "PostgreSQL"
  Note: "Learnova AI Learning Platform - Database Schema v1"
}

/*
===========================================================
  USERS & PROFILES
===========================================================
*/

Table users {
  id uuid [pk]
  email varchar(255) [not null, unique]
  display_name varchar(100)
  avatar_url text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table user_profiles {
  user_id uuid [pk, ref: > users.id]
  grade_level varchar(50)
  country varchar(100)
  language varchar(20) [default: 'en']
  timezone varchar(100)
  learning_goal text
  daily_goal_minutes int
  created_at timestamp [not null]
  updated_at timestamp [not null]
}


/*
===========================================================
  SUBJECT / CURRICULUM
===========================================================
*/

Table subjects {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description text
  icon varchar(255)
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table curriculums {
  id uuid [pk]
  subject_id uuid [not null, ref: > subjects.id]
  name varchar(150) [not null]
  description text
  grade_level varchar(50)
  version varchar(50)
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    subject_id
  }
}

Table topics {
  id uuid [pk]
  curriculum_id uuid [not null, ref: > curriculums.id]
  parent_id uuid [ref: > topics.id]
  name varchar(150) [not null]
  description text
  order_index int
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    curriculum_id
    parent_id
  }
}


/*
===========================================================
  SKILLS / KNOWLEDGE GRAPH
===========================================================
*/

Table skills {
  id uuid [pk]
  subject_id uuid [not null, ref: > subjects.id]
  topic_id uuid [ref: > topics.id]
  code varchar(100) [not null, unique]
  name varchar(200) [not null]
  description text
  difficulty decimal(5,2)
  skill_type varchar(50)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    subject_id
    topic_id
    skill_type
  }
}

Table skill_relationships {
  id uuid [pk]
  from_skill_id uuid [not null, ref: > skills.id]
  to_skill_id uuid [not null, ref: > skills.id]
  relationship_type varchar(50) [not null]
  weight decimal(5,2)
  created_at timestamp [not null]

  indexes {
    from_skill_id
    to_skill_id
    relationship_type

    (from_skill_id, to_skill_id) [unique]
  }
}


/*
===========================================================
  LEARNING CONTENT
===========================================================
*/

Table content {
  id uuid [pk]
  subject_id uuid [not null, ref: > subjects.id]
  topic_id uuid [ref: > topics.id]
  content_type varchar(50) [not null]
  title varchar(255) [not null]
  description text
  body text
  difficulty decimal(5,2)
  estimated_minutes int
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    subject_id
    topic_id
    content_type
  }
}

Table content_skills {
  content_id uuid [not null, ref: > content.id]
  skill_id uuid [not null, ref: > skills.id]
  importance decimal(5,2)

  indexes {
    (content_id, skill_id) [pk]
  }
}


/*
===========================================================
  QUESTIONS
===========================================================
*/

Table questions {
  id uuid [pk]
  subject_id uuid [not null, ref: > subjects.id]
  skill_id uuid [ref: > skills.id]
  question_type varchar(50) [not null]
  difficulty decimal(5,2)
  question_text text [not null]
  explanation text
  answer_data jsonb
  metadata jsonb
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    subject_id
    skill_id
    question_type
    difficulty
  }
}

Table question_skills {
  question_id uuid [not null, ref: > questions.id]
  skill_id uuid [not null, ref: > skills.id]
  weight decimal(5,2) [not null, default: 1.0]

  indexes {
    (question_id, skill_id) [pk]
    skill_id
  }
}

Table question_generations {
  id uuid [pk]
  question_id uuid [not null, ref: > questions.id]
  model varchar(100)
  prompt_version varchar(50)
  generation_metadata jsonb
  quality_score decimal(5,2)
  created_at timestamp [not null]

  indexes {
    question_id
    model
  }
}


/*
===========================================================
  PRACTICE / ASSESSMENT
===========================================================
*/

Table practice_sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [not null, ref: > subjects.id]
  mode varchar(50) [not null]
  started_at timestamp [not null]
  completed_at timestamp

  indexes {
    user_id
    subject_id
    mode
    started_at
  }
}

Table question_attempts {
  id uuid [pk]
  session_id uuid [not null, ref: > practice_sessions.id]
  user_id uuid [not null, ref: > users.id]
  question_id uuid [not null, ref: > questions.id]
  answer_data jsonb
  is_correct boolean
  score decimal(5,2)
  time_spent_ms bigint
  attempt_number int [default: 1]
  created_at timestamp [not null]

  indexes {
    session_id
    user_id
    question_id
    created_at
  }
}


/*
===========================================================
  USER SKILL MASTERY
===========================================================
*/

Table user_skill_mastery {
  user_id uuid [not null, ref: > users.id]
  skill_id uuid [not null, ref: > skills.id]

  mastery_score decimal(5,4) [not null, default: 0]
  confidence decimal(5,4) [not null, default: 0]

  attempt_count int [not null, default: 0]
  correct_count int [not null, default: 0]
  incorrect_count int [not null, default: 0]

  last_attempt_at timestamp
  last_correct_at timestamp
  next_review_at timestamp

  status varchar(50) [not null, default: 'NOT_STARTED']

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (user_id, skill_id) [pk]
    user_id
    skill_id
    status
    next_review_at
  }
}


/*
===========================================================
  AI TUTOR / CONVERSATIONS
===========================================================
*/

Table conversations {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [ref: > subjects.id]
  title varchar(255)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    user_id
    subject_id
    updated_at
  }
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null, ref: > conversations.id]
  role varchar(20) [not null]
  content text [not null]
  metadata jsonb
  created_at timestamp [not null]

  indexes {
    conversation_id
    created_at
  }
}


/*
===========================================================
  RAG / KNOWLEDGE BASE
===========================================================
*/

Table documents {
  id uuid [pk]
  subject_id uuid [ref: > subjects.id]
  content_type varchar(50)
  title varchar(255) [not null]
  source varchar(255)
  source_url text
  metadata jsonb
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    subject_id
    content_type
  }
}

Table document_chunks {
  id uuid [pk]
  document_id uuid [not null, ref: > documents.id]
  content text [not null]
  chunk_index int [not null]
  embedding vector
  metadata jsonb
  created_at timestamp [not null]

  indexes {
    document_id
    chunk_index
  }
}


/*
===========================================================
  RECOMMENDATIONS
===========================================================
*/

Table recommendations {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [not null, ref: > subjects.id]

  recommendation_type varchar(50) [not null]
  target_type varchar(50) [not null]
  target_id uuid

  reason jsonb
  priority int [default: 0]
  status varchar(50) [not null, default: 'PENDING']

  created_at timestamp [not null]
  expires_at timestamp
  completed_at timestamp

  indexes {
    user_id
    subject_id
    recommendation_type
    status
    priority
  }
}


/*
===========================================================
  GAMIFICATION
===========================================================
*/

Table achievements {
  id uuid [pk]
  code varchar(100) [not null, unique]
  name varchar(150) [not null]
  description text
  criteria jsonb
  created_at timestamp [not null]
}

Table user_achievements {
  user_id uuid [not null, ref: > users.id]
  achievement_id uuid [not null, ref: > achievements.id]
  earned_at timestamp [not null]
  metadata jsonb

  indexes {
    (user_id, achievement_id) [pk]
    user_id
    achievement_id
  }
}